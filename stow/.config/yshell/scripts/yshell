#!/usr/bin/env bash
# Starts yshell. The compiled plugin is built by dotfiles/scripts/install-yshell.sh.
shell="$HOME/.config/yshell"
data="${XDG_DATA_HOME:-$HOME/.local/share}/yshell-light"
export QML2_IMPORT_PATH="${YSHELL_PLUGIN:-$data/build/qml}:$shell/qml-shims"
exec quickshell -p "$shell" "$@"
