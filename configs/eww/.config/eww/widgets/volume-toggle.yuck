(defwidget volume-toggle []
    (button
        :class "volume-toggle-button"
        :onclick "scripts/toggle-volume-modal.sh"

        (box
            :orientation "h"
            :space-evenly false
            :spacing 6

            (label
                :text "󰕾"
                :class "volume-toggle-icon"
            )

            (for output in output_device_volumes
                (label
                    :visible "${output.is_default}"
                    :text "${output.volume}%"
                    :class "volume-toggle-percentage"
                )
            )
        )
    )
)
