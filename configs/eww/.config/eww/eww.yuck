;; ========================================
;; Variables
;; ========================================

(defvar show_panel false)

(defpoll time 
    :interval "1s"
    "date '+%H:%M'")

(defpoll date 
    :interval "60s"
    "date '+%a %d %b'")

(deflisten workspaces 
    :initial "[]"
    "scripts/workspaces-all.sh")

(deflisten default_audio_volume 
    :initial "0"
    "scripts/listen-default-audio-volume.sh")

(deflisten is_audio_muted
    :initial "0"
    "scripts/listen-default-audio-mute.sh")

(deflisten default_audio
    "scripts/listen-default-audio-selected.sh")

(deflisten audio_outputs
    :initial "[]"
    "scripts/listen-audio-outputs.sh")

(defpoll available_audio_outputs
    :interval "5s"
    :initial "[]"
    "scripts/list-audio-outputs.sh")

(defpoll current_audio_output
    :interval "1s"
    "scripts/get-current-audio-output.sh")

;; ========================================
;; Widgets
;; ========================================

(include "widgets/workspaces.yuck")
(include "widgets/time.yuck")
(include "widgets/audio.yuck")
(include "widgets/tray-system.yuck")
(include "widgets/panel-toggle.yuck")
(include "widgets/bar.yuck")

;; ========================================
;; Windows
;; ========================================

(include "windows/bar.yuck")
(include "windows/calendar-dropdown.yuck")
(include "windows/audio-output-selector.yuck")
(include "windows/outputs-volume-popup.yuck")
(include "windows/system-menu.yuck")
(include "windows/panel.yuck")
