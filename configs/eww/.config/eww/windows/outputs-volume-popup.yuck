(defwindow outputs-volume-popup 
    :monitor "DP-2"
    :geometry (geometry
        :x "-210px"
        :y "60px"
        :anchor "right top"
    )
    (box 
        :class "outputs-volume-popup"

        (box 
            :orientation "v"
            :halign "start"
            :spacing 10

            (for output in audio_outputs
                (box
                    :spacing 8
                    :halign "start"

                    (label :text "${output.name}")
                    (scale 
                        :value "${output.volume}"
                        :min 0
                        :max 100
                        :onchange "pactl set-sink-input-volume ${output.id} {}%"
                    )
                )
            )
        )
    )
)
