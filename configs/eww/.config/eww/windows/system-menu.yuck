(defwindow system-menu-backdrop
    :monitor "DP-4"
    :windowtype "dialog"
    :geometry (geometry
        :x "0%"
        :y "0%"
        :width "100%"
        :height "100%"
        :anchor "top left")
    :stacking "fg"

    (button
        :class "modal-backdrop-hit"
        :hexpand true
        :vexpand true
        :onclick "eww close system-menu; eww close system-menu-backdrop"
    )
)

(defwindow system-menu
    :monitor "DP-4"
    :windowtype "dialog"
    :geometry (geometry 
        :x "-8px"
        :y "50px"
        :width "200px"
        :anchor "top right"
    )

    (box 
        :class "system-menu-window"
        :orientation "v"
        :space-evenly false

        (button 
            :class "system-menu-item"
            :onclick "systemctl reboot && eww close system-menu && eww close system-menu-backdrop"

            (label :text "Restart")
        )

        (button 
            :class "system-menu-item"
            :onclick "systemctl suspend && eww close system-menu && eww close system-menu-backdrop"

            (label :text "Suspend")
        )
        (button 
            :class "system-menu-item"
            :onclick "scripts/update-and-shutdown.sh && eww close system-menu && eww close system-menu-backdrop"

            (label :text "Update & Shutdown")
        )
        (button 
            :class "system-menu-item"
            :onclick "systemctl poweroff && eww close system-menu && eww close system-menu-backdrop"

            (label :text "Shutdown")
        )
    )
)
