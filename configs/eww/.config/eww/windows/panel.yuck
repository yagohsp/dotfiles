(defwindow panel
    :monitor "DP-4"
    :windowtype "dialog"
    :geometry (geometry 
        :x "0%"
        :y "0%"
        :width "100%"
        :height "100%"
        :anchor "top left")
    :stacking "fg"

    (box 
        :class "panel-window"
        :orientation "v"
        :space-evenly false
        :visible show_panel

        (box
            :class "panel-header"
            :halign "end"
            :space-evenly false
            :width 50
            :height 32

            (button
                :class "panel-close-button"
                :onclick "eww update show_panel=false"

                (label :text "✕")
            )
        )

        (box
            :class "panel-content"
            :orientation "v"
            :space-evenly false
            :spacing 10
            :hexpand true
            :vexpand true

            (label :text "Panel Content" :class "panel-title")
            (label :text "Add your content here")
        )
    )
)
