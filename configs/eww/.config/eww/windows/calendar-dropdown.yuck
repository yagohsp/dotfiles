(defwindow calendar-backdrop
    :monitor "DP-4"
    :windowtype "dialog"
    :geometry (geometry
        :x "0%"
        :y "0%"
        :width "100%"
        :height "100%"
        :anchor "top left")
    :stacking "fg"

    (button
        :class "modal-backdrop-hit"
        :hexpand true
        :vexpand true
        :onclick "eww close calendar-dropdown; eww close calendar-backdrop"
    )
)

(defwindow calendar-dropdown
    :monitor "DP-4"
    :windowtype "dialog"
    :geometry (geometry 
        :x "0px"
        :y "36px"
        :anchor "top center")

    (box 
        :class "calendar-window"
        :orientation "v"

        (calendar :class "calendar-widget")
    )
)
