(defwindow bar
    :monitor "DP-4"
    :windowtype "dock"
    :geometry (geometry 
        :x "0%"
        :y "0%"
        :width "100%"
        :height "32px"
        :anchor "top center")
    :reserve (struts :side "top" :distance "32px")
    :stacking "fg"
    :exclusive true

    (bar :workspaces_var workspaces :monitor_name "DP-4")
)

(defwindow bar-dp0
    :monitor "HDMI-0"
    :windowtype "dock"
    :geometry (geometry 
        :x "0%"
        :y "0%"
        :width "100%"
        :height "32px"
        :anchor "top center")
    :reserve (struts :side "top" :distance "32px")
    :stacking "fg"
    :exclusive true

    (bar :workspaces_var workspaces :monitor_name "HDMI-0")
)
