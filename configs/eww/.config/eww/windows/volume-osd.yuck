(defwindow volume-osd
    :monitor "DP-4"
    :windowtype "notification"
    :focusable false
    :wm-ignore true
    :geometry (geometry
        :x "24px"
        :y "24px"
        :width "200px"
        :height "60px"
        :anchor "top left")
    :stacking "overlay"

    (box
        :class "volume-osd"
        :orientation "h"
        :space-evenly false
        :spacing 12

        (label
            :class "volume-osd-icon"
            :text "${volume_osd_muted ? '󰝟' : '󰕾'}"
        )

        (box
            :orientation "v"
            :space-evenly false
            :spacing 6
            :valign "center"
            :hexpand true

            (label
                :class "volume-osd-value"
                :halign "start"
                :text "${volume_osd_value}%"
                :visible "${!volume_osd_muted}"
            )

            (label
                :class "volume-osd-value"
                :halign "start"
                :text "Muted"
                :visible volume_osd_muted
            )

            (progress
                :class "volume-osd-bar"
                :value "${volume_osd_muted ? 0 : volume_osd_value}"
                :hexpand true
            )
        )
    )
)
