(defwindow volume-modal-backdrop
    :monitor "DP-4"
    :windowtype "dialog"
    :geometry (geometry
        :x "0%"
        :y "0%"
        :width "100%"
        :height "100%"
        :anchor "top left")
    :stacking "fg"

    (button
        :class "modal-backdrop-hit"
        :hexpand true
        :vexpand true
        :onclick "eww close volume-modal; eww close volume-modal-backdrop"
    )
)

(defwindow volume-modal
    :monitor "DP-4"
    :windowtype "dialog"
    :geometry (geometry
        :x "-8px"
        :y "50px"
        :width "336px"
        :height "80%"
        :anchor "top right"
    )

    (box
        :class "volume-modal-window"
        :orientation "v"
        :space-evenly false
        :spacing 10

        (box
            :class "volume-modal-header"
            :orientation "h"
            :space-evenly false
            :halign "fill"
        )

        (scroll
            :vexpand true

            (box
                :orientation "v"
                :space-evenly false
                :spacing 12

                (box
                    :class "volume-section"
                    :orientation "v"
                    :space-evenly false
                    :spacing 8

                    (for output in output_device_volumes
                        (box
                            :class "volume-device-row"
                            :orientation "v"
                            :space-evenly false
                            :spacing 8

                            (box
                                :class "volume-header-row"
                                :orientation "h"
                                :space-evenly false
                                :halign "fill"

                                (label :text "${output.name}" :class "volume-device-label")
                            )

                            (box
                                :class "volume-control-row"
                                :orientation "h"
                                :space-evenly false
                                :spacing 10

                                (box
                                    :class "volume-inline-meta"
                                    :orientation "h"
                                    :space-evenly false
                                    :spacing 6

                                    (button
                                        :class "volume-mute-button ${output.muted ? 'muted' : ''}"
                                        :onclick "scripts/toggle-output-device-mute.sh '${output}'"

                                        (label :text "${output.muted ? '󰝟' : '󰕾'}")
                                    )

                                    (label :text "${output.volume}%" :class "volume-device-value")
                                )

                                (scale
                                    :value "${output.volume}"
                                    :min 0
                                    :max 100
                                    :hexpand true
                                    :onchange "scripts/set-output-device-volume.sh '${output}' {}"
                                )
                            )
                        )
                    )
                )

                (box :class "volume-modal-divider")

                (box
                    :class "volume-section"
                    :orientation "v"
                    :space-evenly false
                    :spacing 8

                    (for stream in app_stream_routes
                        (box
                            :class "stream-route-row"
                            :orientation "v"
                            :space-evenly false
                            :spacing 8

                            (box
                                :orientation "v"
                                :space-evenly false
                                :spacing 2
                                :halign "center"

                                (label :text "${stream.name}" :class "stream-route-label")
                            )

                            (box
                                :class "stream-volume-row"
                                :orientation "v"
                                :space-evenly false
                                :spacing 4

                                (box
                                    :class "volume-control-row"
                                    :orientation "h"
                                    :space-evenly false
                                    :spacing 10

                                    (box
                                        :class "volume-inline-meta"
                                        :orientation "h"
                                        :space-evenly false
                                        :spacing 6

                                        (button
                                            :class "volume-mute-button ${stream.muted ? 'muted' : ''}"
                                            :onclick "scripts/toggle-stream-mute.sh ${stream.index}"

                                            (label :text "${stream.muted ? '󰝟' : '󰕾'}")
                                        )

                                        (label :text "${stream.volume}%" :class "stream-volume-value")
                                    )

                                    (scale
                                        :value "${stream.volume}"
                                        :min 0
                                        :max 100
                                        :hexpand true
                                        :onchange "scripts/set-stream-volume.sh ${stream.index} {}"
                                    )
                                )
                            )

                            (box
                                :class "stream-output-row"
                                :orientation "h"
                                :space-evenly false
                                :spacing 6
                                :halign "center"

                                (button
                                    :visible "${stream.output_1_name != ''}"
                                    :class "stream-output-button ${stream.output_1_current ? 'active' : ''}"
                                    :onclick "scripts/set-stream-output.sh ${stream.index} '${stream.output_1_sink_name}'"

                                    (label :text "${stream.output_1_button_label}")
                                )

                                (button
                                    :visible "${stream.output_2_name != ''}"
                                    :class "stream-output-button ${stream.output_2_current ? 'active' : ''}"
                                    :onclick "scripts/set-stream-output.sh ${stream.index} '${stream.output_2_sink_name}'"

                                    (label :text "${stream.output_2_button_label}")
                                )

                                (button
                                    :visible "${stream.output_3_name != ''}"
                                    :class "stream-output-button ${stream.output_3_current ? 'active' : ''}"
                                    :onclick "scripts/set-stream-output.sh ${stream.index} '${stream.output_3_sink_name}'"

                                    (label :text "${stream.output_3_button_label}")
                                )
                            )
                        )
                    )
                )
            )
        )
    )
)
