#!/usr/bin/env python3
"""Recolours Bibata Modern Classic for a theme.

usage: build-bibata-theme <Bibata-Modern-Classic dir> <output theme dir> <fill hex> <outline hex>

Classic is black with a white outline, so each pixel's brightness says how far it
sits between the fill and the outline colour.
"""
import shutil
import struct
import sys
from pathlib import Path

import numpy as np



def colour(value: str) -> np.ndarray:
    return np.array([int(value[i:i + 2], 16) for i in (0, 2, 4)], dtype=float)


FILL = colour(sys.argv[3])
OUTLINE = colour(sys.argv[4])
IMAGE = 0xfffd0002


def recolour(data: bytearray) -> None:
    ntoc = struct.unpack_from("<I", data, 12)[0]
    for i in range(ntoc):
        kind, _, pos = struct.unpack_from("<III", data, 16 + i * 12)
        if kind != IMAGE:
            continue
        width, height = struct.unpack_from("<II", data, pos + 16)
        start = pos + 36
        pixels = np.frombuffer(data, np.uint8, width * height * 4, start).astype(float)
        bgra = pixels.reshape(-1, 4)
        alpha = bgra[:, 3:] / 255
        straight = np.divide(bgra[:, :3], alpha, out=np.zeros_like(bgra[:, :3]), where=alpha > 0)
        brightness = np.clip(straight.mean(axis=1, keepdims=True) / 255, 0, 1)
        rgb = FILL + (OUTLINE - FILL) * brightness
        bgra[:, :3] = rgb[:, ::-1] * alpha
        data[start:start + width * height * 4] = np.rint(bgra).astype(np.uint8).tobytes()


def main() -> None:
    source, output = Path(sys.argv[1]), Path(sys.argv[2])
    if output.exists():
        shutil.rmtree(output)
    shutil.copytree(source, output, symlinks=True)
    (output / "index.theme").write_text(f"[Icon Theme]\nName={output.name}\nComment=Bibata Modern recoloured\n")
    for path in (output / "cursors").iterdir():
        if path.is_file() and not path.is_symlink():
            data = bytearray(path.read_bytes())
            recolour(data)
            path.write_bytes(data)


main()
